# ─────────────────────────────────────────────────────────────────────────────
# Caryanams DMS — Environment Variables (PostgreSQL)
# Copy this file and fill in your actual values before running the app.
# NEVER commit the filled-in .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL Database URL ────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:dkc190802@localhost:5432/caryanams_db

# ── Flask Secret Key ──────────────────────────────────────────────────────
# Signs the dealer/user sign-in cookies and keys the stored OTP hashes.
# Leave blank and the app creates a random key in instance/secret_key on first
# start. Set your own long random value if you run more than one server, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── App Base URL (for minisite links) ────────────────────────────────────
APP_URL=http://localhost:5000

# ── Razorpay Payment Gateway ──────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Bank / UPI Fallback Details ───────────────────────────────────────────
UPI_ID=caryanams@upi
UPI_NAME=Caryanams Payments
BANK_NAME=HDFC Bank
BANK_ACNAME=Caryanams Pvt Ltd
BANK_ACCNO=50200012345678
BANK_IFSC=HDFC0001234
BANK_BRANCH=Main Branch

# ── v29 SaaS onboarding flow (added by apply_saas_flow_patch.py) ──────────
# Master switch for the plan gate. True = dealers without an active plan
# cannot reach /dealer/* or /studio/*, by link or by typing the URL.
SUBSCRIPTION_GATE_ENABLED=True
# Validity granted by one activation, in days.
SUBSCRIPTION_DEFAULT_DAYS=30
# No longer used: after sign-up (mobile verified by SMS) people are always
# signed straight in. Kept only so old copies of this file still load.
AUTO_LOGIN_AFTER_SIGNUP=True
# Allow activating a PAID plan for free (demo/trial). The ₹0 Starter plan is
# always activatable regardless of this flag.
ALLOW_FREE_PLAN_ACTIVATION=True

# ── Reverse proxy (production) ───────────────────────────────────────────
# Number of proxies in front of the app (Nginx = 1, Cloudflare + Nginx = 2).
# Needed for the per-IP OTP limit and HTTPS-only cookies. 0 = none.
TRUSTED_PROXY_COUNT=0

# ── SMS login codes (dealers & users sign in with mobile + OTP) ───────────
# console  = TEST MODE: no SMS is sent; the code is printed in the app window.
# fast2sms = Fast2SMS (India)   msg91 = MSG91 (India)   twilio = Twilio (global)
SMS_PROVIDER=msg91
# Fast2SMS: https://www.fast2sms.com → Dev API → API key
FAST2SMS_API_KEY=
# MSG91: https://control.msg91.com → Authkey, plus a DLT-approved OTP template ID
MSG91_AUTH_KEY=408126Ak0578Rff65b8c39cP1
MSG91_TEMPLATE_ID=65b8c2b7d6fc053928590193
# Twilio: https://console.twilio.com → Account SID, Auth Token, and your Twilio number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── TEMPORARY dealer demo login (until the SMS OTP API is live) ───────────
# /auth/login → "Dealer demo login": mobile number 9999999999 + this OTP.
# Only works while SMS_PROVIDER=console. Set DEMO_LOGIN_ENABLED=False (or
# delete these lines) before going live.
DEMO_LOGIN_ENABLED=True
DEMO_LOGIN_OTP=111111
DEMO_DEALER_EMAIL=dealer@caryanams.com
